# ── Environment ───────────────────────────────────────────────────────────────
# Set to "dev"  → uses local Ollama at OLLAMA_BASE_URL_DEV, no API key
# Set to "prod" → uses OLLAMA_BASE_URL_PROD with OLLAMA_API_KEY
APP_ENV=dev

# ── Ollama model names ─────────────────────────────────────────────────────────
# Dev model (fast local)
OLLAMA_MODEL_DEV=llama3:8b
# Prod model (AWS EC2 Ollama)
OLLAMA_MODEL_PROD=llama3
# Legacy fallback
OLLAMA_MODEL=llama3:8b

# ── Ollama timeouts & context ──────────────────────────────────────────────────
LOCAL_LLM_TIMEOUT=180
OLLAMA_NUM_PREDICT=2048
OLLAMA_NUM_CTX=4096
OLLAMA_CHUNK_TIMEOUT=60

# Dev: local Ollama (no auth required)
OLLAMA_BASE_URL_DEV=http://localhost:11434

# Prod: AWS-hosted Ollama (fill in your EC2 public IP / domain)
OLLAMA_BASE_URL_PROD=http://3.83.33.4:11434

# Universal fallback used by v2 pipeline
OLLAMA_BASE_URL=http://localhost:11434

# API key used only in prod mode
OLLAMA_API_KEY=e946a75638b8497d9221350d51e129d1.iOGaKFskHo-oMnK9TD_TTSWe

# ── Tavily MCP (real-time web search) ─────────────────────────────────────────
# Get your free API key at https://tavily.com
TAVILY_API_KEY=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
MCP_SERVER_CMD=npx -y tavily-mcp@latest
MCP_TIMEOUT=30

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# ── Exchange rates ────────────────────────────────────────────────────────────
EUR_USD=1.09

# ── Hotel API (optional, disabled by default) ────────────────────────────────
# HOTEL_API_PROVIDER=rapidapi
# RAPIDAPI_KEY=your-key-here
