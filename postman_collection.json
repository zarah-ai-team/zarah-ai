    {
      "name": "Test Formal Request (Oman)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Dear Ms., Meghana,\\n \\nPlease find below the query for your kind reference:-\\n\\nDestination       :             Oman\\nCheck In            :             14th Jan 2026\\nCheck Out         :             19th Jan 2026\\nDuration             :             05N/06D\\nNo. of Pax          :             04 (Adults)\\nNo. of Rooms   :             02\\nHotel                  :             4* or similar\\n \\nNeed feasible Itinerary and leisure itinerary. We don't need hectic schedule.\\n \\nKinldy check if stay can be split between Muscat and some other place.\\nWe need Hotel Cost and Last cost separately. All Transfers & Sightseeing on Private Basis.\\n \\nLooking forward to your early response!!\"\n}\n"
        },
        "url": {
          "raw": "http://localhost:8000/api/chat",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "api",
            "chat"
          ]
        },
        "description": "Test formal request parser with Oman travel query"
      },
      "response": []
    },
