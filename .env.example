# ── Environment ───────────────────────────────────────────────────────────────
# "dev" = local Ollama, no auth  |  "prod" = remote Ollama + OLLAMA_API_KEY
APP_ENV=dev

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.1:8b
LOCAL_LLM_TIMEOUT=300
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
OLLAMA_CHUNK_TIMEOUT=120

OLLAMA_BASE_URL_DEV=http://localhost:11434
OLLAMA_BASE_URL_PROD=http://<YOUR_AWS_IP>:11434
OLLAMA_API_KEY=

# ── MCP server (ollama-web-search-mcp) ────────────────────────────────────────
# Requires Node.js >= 18 installed and accessible in PATH.
# The server is launched as a subprocess via stdio on first request.
MCP_SERVER_CMD=npx -y ollama-web-search-mcp
MCP_TIMEOUT=200

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# ── Exchange rates (EUR → USD applied in pricing_engine.py) ──────────────────
EUR_USD=1.09

# ── AWS S3 (leave blank to use local disk storage at data/uploads/) ──────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ── Storage paths ─────────────────────────────────────────────────────────────
LOCAL_UPLOAD_DIR=data/uploads
USER_KB_DOCS_DIR=data/user_kb_docs
MAX_UPLOAD_MB=50

# ── Hotel API (optional, disabled by default) ────────────────────────────────
HOTEL_API_ENABLED=false
# HOTEL_API_PROVIDER=rapidapi
# RAPIDAPI_KEY=your-key-here
